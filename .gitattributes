# Normalize line endings so the repo stays consistent across machines.
* text=auto eol=lf

*.cpp  text eol=lf
*.h    text eol=lf
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf

# Binary artifacts should never be committed
*.exe  binary
*.dll  binary
